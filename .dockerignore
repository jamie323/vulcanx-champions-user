# ── Git / IDE ──────────────────────────────────────────────────────────────
.git/
.gitignore
.claude/
.playwright-mcp/

# ── Dev-only Python image-generation scripts ───────────────────────────────
scripts/

# ── Bulk art directories ───────────────────────────────────────────────────
# allbloodlines*/ are source-of-truth high-res renders (GBs, never served).
# evolution20/ IS served — bloodlines.json points every stage's `img` field
# at evolution20/<species>/<bloodline>/sNN.png. Excluding it broke the live
# champion images (Trello eyc94EPh chain, 2026-05-27).
allbloodlines/
allbloodlines_v1/
# adventures/ IS served (location tiles + banner); only the raw 1536px PNG
# source masters are excluded — the optimized JPEGs beside them ship.
adventures/_raw/

# ── OS noise ───────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo

# ── Docker build files themselves ──────────────────────────────────────────
Dockerfile
.dockerignore
# nginx.conf is intentionally NOT excluded — it is COPY'd into the container

# ── Arena prototype screenshots ────────────────────────────────────────────
arena-*.png

# ── Docs / READMEs (not required at runtime) ──────────────────────────────
README.md
